# Application
APP_NAME=Aurex Platform API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8010
WEB_HOST=127.0.0.1
WEB_PORT=4210
WEB_ORIGINS=http://127.0.0.1:4210,http://localhost:4210
TRUSTED_HOSTS=127.0.0.1,localhost

# SQL Server Express
# Copy this file to .env and enter the values manually. Never commit .env.
SQL_SERVER=localhost\SQLEXPRESS
SQL_HOST=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=ForexSaas
SQL_USERNAME=ForexSaasApp
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# Google SMTP
# Use a Google App Password, not the normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aurex
SMTP_USE_TLS=true
TRADE_REPORT_RECIPIENT=
DAILY_PROGRESS_REPORT_ENABLED=true
DAILY_PROGRESS_REPORT_HOUR_SAST=18

# IG demo connection (live is rejected by application validation)
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_ENVIRONMENT=demo
ALLOW_DEMO_TRADING=false
ALLOW_LIVE_TRADING=false
EXPERIMENTAL_DEMO_ENABLED=false

# South African launch defaults
REPORTING_CURRENCY=ZAR
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en-ZA
OWNER_DISPLAY_NAME=Demo owner
OWNER_EMAIL=

# Authentication and worker safety
SESSION_COOKIE_NAME=aurex_session
SESSION_HOURS=12
# Keep false only for localhost HTTP development. Production HTTPS must use true.
SESSION_COOKIE_SECURE=false
# Set a long random value before any public-domain deployment. It is used only
# to irreversibly hash sign-in identifiers in the throttling ledger.
AUTH_HASH_PEPPER=
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_MAX_EMAIL_FAILURES=5
AUTH_MAX_ADDRESS_FAILURES=20
AUTH_LOCKOUT_MINUTES=30
BACKGROUND_SYNC_ENABLED=true
ACCOUNT_SYNC_SECONDS=60
STALE_AFTER_SECONDS=180
SHADOW_CYCLE_SECONDS=30
BROKER_RULE_SYNC_SECONDS=900
MODEL_TRAINING_CHECK_SECONDS=21600
MODEL_MINIMUM_ROWS=2000
MODEL_ACCEPTANCE_AUC=0.52
INTELLIGENCE_ENABLED=false
INTELLIGENCE_LOCAL_ONLY=true
LLM_PROVIDER=disabled
LLM_MODEL_FAST=
LLM_MODEL_DEEP=
LLM_BASE_URL=
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_PROVIDER=disabled
TRADINGAGENTS_BASE_URL=
TRADINGAGENTS_QUICK_MODEL=
TRADINGAGENTS_DEEP_MODEL=
TRADINGAGENTS_VERSION=0.4.0
TRADINGAGENTS_COMMIT=c95f83dfafa748801ab2be4855e6fcffc93804e4
TRADINGAGENTS_PROMPT_VERSION=aurex-forex-v1
TRADINGAGENTS_MAX_CONCURRENT_RUNS=1
TRADINGAGENTS_MAX_CONTEXT_CHARS=48000
TRADINGAGENTS_MAX_OUTPUT_TOKENS=2048
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
# Optional provider secret. Never expose this through an API or commit a real value.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
HISTORICAL_BACKFILL_ENABLED=false
HISTORICAL_BACKFILL_POLL_SECONDS=60
HISTORICAL_BACKFILL_MIN_FREE_GB=20
HISTORICAL_BACKFILL_MAX_ATTEMPTS=3
HISTORICAL_MINIMUM_COVERAGE=0.99
HISTORICAL_MAXIMUM_LARGEST_GAP_MINUTES=15
HISTORICAL_MAXIMUM_UNEXPECTED_GAPS=250
HISTORICAL_MAXIMUM_REJECTED_TICK_RATIO=0.001
HISTORICAL_MINIMUM_CROSS_SOURCE_CANDLES=100
HISTORICAL_MINIMUM_CROSS_SOURCE_MATCH=0.99
HISTORICAL_CROSS_SOURCE_TOLERANCE_RATIO=0.0005
HISTORICAL_MINIMUM_COVERAGE=0.99
HISTORICAL_MAXIMUM_LARGEST_GAP_MINUTES=15
HISTORICAL_MAXIMUM_UNEXPECTED_GAPS=250
HISTORICAL_MAXIMUM_REJECTED_TICK_RATIO=0.001
HISTORICAL_MINIMUM_CROSS_SOURCE_CANDLES=100
HISTORICAL_MINIMUM_CROSS_SOURCE_MATCH=0.99
HISTORICAL_CROSS_SOURCE_TOLERANCE_RATIO=0.0005
HISTORICAL_MINIMUM_COVERAGE=0.99
HISTORICAL_MAXIMUM_LARGEST_GAP_MINUTES=15
HISTORICAL_MAXIMUM_UNEXPECTED_GAPS=250
HISTORICAL_MAXIMUM_REJECTED_TICK_RATIO=0.001
HISTORICAL_MINIMUM_CROSS_SOURCE_CANDLES=100
HISTORICAL_MINIMUM_CROSS_SOURCE_MATCH=0.99
HISTORICAL_CROSS_SOURCE_TOLERANCE_RATIO=0.0005
LOG_LEVEL=INFO

# Safety controls
# Change to demo only after GET /api/v1/trading/readiness reports every non-opt-in gate passing.
TRADING_MODE=disabled
BROKER_ENVIRONMENT=demo
