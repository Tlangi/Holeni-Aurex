# Application
APP_NAME=Aurex Platform API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8010
WEB_HOST=127.0.0.1
WEB_PORT=4210
WEB_ORIGINS=http://127.0.0.1:4210,http://localhost:4210

# SQL Server Express
# Copy this file to .env and enter the values manually. Never commit .env.
SQL_SERVER=localhost\SQLEXPRESS
SQL_HOST=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=ForexSaas
SQL_USERNAME=ForexSaasApp
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# Google SMTP
# Use a Google App Password, not the normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aurex
SMTP_USE_TLS=true
TRADE_REPORT_RECIPIENT=
DAILY_PROGRESS_REPORT_ENABLED=true
DAILY_PROGRESS_REPORT_HOUR_SAST=18

# IG demo connection (live is rejected by application validation)
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_ENVIRONMENT=demo
ALLOW_DEMO_TRADING=false
ALLOW_LIVE_TRADING=false

# South African launch defaults
REPORTING_CURRENCY=ZAR
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en-ZA
OWNER_DISPLAY_NAME=Demo owner
OWNER_EMAIL=

# Authentication and worker safety
SESSION_COOKIE_NAME=aurex_session
SESSION_HOURS=12
# Keep false only for localhost HTTP development. Production HTTPS must use true.
SESSION_COOKIE_SECURE=false
BACKGROUND_SYNC_ENABLED=true
ACCOUNT_SYNC_SECONDS=60
STALE_AFTER_SECONDS=180
SHADOW_CYCLE_SECONDS=30
BROKER_RULE_SYNC_SECONDS=900
MODEL_TRAINING_CHECK_SECONDS=21600
MODEL_MINIMUM_ROWS=2000
MODEL_ACCEPTANCE_AUC=0.52
LOG_LEVEL=INFO

# Safety controls
# Change to demo only after GET /api/v1/trading/readiness reports every non-opt-in gate passing.
TRADING_MODE=disabled
BROKER_ENVIRONMENT=demo
